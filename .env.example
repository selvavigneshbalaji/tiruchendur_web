# Google hotel-data integrations
GOOGLE_SHEETS_CSV_URL=
APPS_SCRIPT_URL=

# Server-only URL of the Cloudflare D1/R2 Worker used by the admin and owner portal.
# Do not expose credentials in this value.
PORTAL_WORKER_URL=https://tiruchendur-stays-api.tiruchendur-stays-api.workers.dev

# Sentry error monitoring. A DSN is safe to expose to the browser; never
# expose SENTRY_AUTH_TOKEN, which is only needed by the deployment for source maps.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
